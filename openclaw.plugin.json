{
  "id": "avatar",
  "name": "OpenClaw Avatar",
  "description": "A local animated avatar surface driven by canonical voice-session media events.",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": { "type": "boolean", "default": true },
      "standalonePort": { "type": "integer", "minimum": 0, "maximum": 65535, "default": 0 },
      "maxAudioChunkBytes": { "type": "integer", "minimum": 2, "maximum": 192000, "default": 96000 },
      "maxSubscriberMediaBytes": { "type": "integer", "minimum": 65536, "maximum": 8388608, "default": 1048576 },
      "video": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "width": { "type": "integer", "minimum": 320, "maximum": 3840, "default": 1280 },
          "height": { "type": "integer", "minimum": 240, "maximum": 2160, "default": 720 },
          "frameRate": { "type": "integer", "minimum": 1, "maximum": 60, "default": 30 }
        }
      }
    }
  }
}
